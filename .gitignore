# Data — corpus is large and downloadable; never commit it
data/raw/
data/corpus/
data/seeded/
*.xlsx
*.xls
!tests/fixtures/*.xlsx

# ...but DO commit the ground-truth manifests. They are 88 KB of JSON and they are
# the answer key: with them, a reader can check our scoring against the exact seeds
# we scored, without first rebuilding a 1.9 GB corpus. The seeded workbooks
# themselves stay out -- they are regenerable from the corpus with `--seed 42`.
!data/seeded/*.truth.json

# Results are regenerated, but keep the committed evaluation snapshots
results/scratch/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Env / secrets — never commit credentials (ground rule 8)
.env
.env.*
*.key
*.pem
secrets.*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Tooling caches present in the workspace
.tokensave/
